# Pretrained rembg model used by Flow A. Try these one at a time:
# birefnet-general-lite  (initial baseline; smaller than full model)
# birefnet-general       (quality comparison; heavier)
# isnet-general-use      (alternative comparison)
# u2net                  (older/lightweight baseline)
REMBG_MODEL=birefnet-general-lite

# Output and resource limits
OUTPUT_SIZE=1024
MAX_INPUT_EDGE=2400
CANVAS_FILL_RATIO=0.82
MAX_UPLOAD_BYTES=15728640
MAX_CONCURRENT_JOBS=1
