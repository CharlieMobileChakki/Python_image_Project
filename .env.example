# =============================================================================
# Arangtik Garment AI — Server & Concurrency Settings
# =============================================================================
OUTPUT_SIZE=1024
MAX_UPLOAD_BYTES=15728640
# 'auto' automatically scales concurrency with RUNPOD_MAX_WORKERS or HTTP cluster capacity
MAX_CONCURRENT_JOBS=auto

# =============================================================================
# Direct 1024x1024 Studio Pipeline (ChatGPT Vision + Remote Qwen 2.1 GPU Backend)
# Switch providers anytime with ZERO code edits — just change URL & key below!
# =============================================================================
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_VISION_MODEL=gpt-4o-mini

# Option 1 (Recommended): RunPod Serverless Endpoint URL
#   QWEN_REMOTE_URL=https://api.runpod.ai/v2/<YOUR_ENDPOINT_ID>
#   RUNPOD_API_KEY=rpa_xxxxxxxxxxxxxxxxxxxx
#   RUNPOD_MAX_WORKERS=5
#
# Option 2: Dedicated GPU Server / Pod / Multi-Server Cluster (comma-separated HTTP URLs)
#   QWEN_REMOTE_URL=http://<GPU_IP>:8001
#   QWEN_REMOTE_URL=http://<GPU_IP_1>:8001,http://<GPU_IP_2>:8001
#   QWEN_API_KEY=your-optional-worker-key

QWEN_REMOTE_URL=https://api.runpod.ai/v2/<YOUR_ENDPOINT_ID>
RUNPOD_API_KEY=rpa_your_runpod_api_key_here
RUNPOD_MAX_WORKERS=1
QWEN_APPAREL_SIZE=1024
QWEN_API_KEY=
QWEN_TIMEOUT_SECONDS=600
