# =============================================================================
# Flow A (Without Person — Runs locally on Contabo CPU Server)
# =============================================================================
REMBG_MODEL=birefnet-general-lite
OUTPUT_SIZE=1024
MAX_INPUT_EDGE=2400
CANVAS_FILL_RATIO=0.82
MAX_UPLOAD_BYTES=15728640
MAX_CONCURRENT_JOBS=2

# =============================================================================
# Flow B (With Person — ChatGPT Vision + Remote AIC Cloud RTX 3090 GPU Server)
# =============================================================================
# Step 1: OpenAI ChatGPT Vision API (analyzes model photo & writes garment prompt)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_VISION_MODEL=gpt-4o-mini

# Step 2: AIC Cloud RTX 3090 GPU Worker URL (running gpu_worker/server.py on port 8001)
QWEN_REMOTE_URL=https://methodology-opens-characterization-drawing.trycloudflare.com
QWEN_API_KEY=arangtik-gpu-secret-2026
QWEN_TIMEOUT_SECONDS=180
