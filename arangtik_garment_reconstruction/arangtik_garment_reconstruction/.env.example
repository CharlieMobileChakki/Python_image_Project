APP_NAME=Arangtik Garment Reconstruction API
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Official SDXL inpainting checkpoint
SDXL_MODEL_ID=diffusers/stable-diffusion-xl-1.0-inpainting-0.1
IP_ADAPTER_REPO=h94/IP-Adapter
IP_ADAPTER_SUBFOLDER=sdxl_models
IP_ADAPTER_WEIGHT=ip-adapter-plus_sdxl_vit-h.safetensors
IP_ADAPTER_IMAGE_ENCODER_SUBFOLDER=models/image_encoder

# GPU configuration
DEVICE=cuda
ALLOW_CPU_FALLBACK=false
USE_MODEL_CPU_OFFLOAD=false
ENABLE_VAE_SLICING=true
ENABLE_VAE_TILING=true

# Inference defaults
DEFAULT_STEPS=30
DEFAULT_GUIDANCE_SCALE=5.5
DEFAULT_STRENGTH=0.95
DEFAULT_IP_ADAPTER_SCALE=0.75
MAX_IMAGE_SIDE=1024
MAX_UPLOAD_MB=25
MASK_BLUR_RADIUS=1.5

# Set this to a fixed seed for repeatable tests, or leave empty for random seeds.
DEFAULT_SEED=
